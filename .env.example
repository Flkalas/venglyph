# Hub HTTP
HUB_PORT=8787
HUB_HOST=127.0.0.1

# SQLite WAL store (single file)
HUB_DB_PATH=./data/hub.db

# Worker auth token (shared secret for hello frame)
HUB_WORKER_TOKEN=dev-worker-token

# Full-auto: auto-approve confirm tier only (deny never)
HUB_FA=0

# Local llmster / LM Studio OpenAI-compatible API
HUB_LLM_BASE_URL=http://127.0.0.1:1234/v1
HUB_LLM_MODEL=qwen/qwen3.5-9b
# Optional code-route model (defaults to HUB_LLM_MODEL)
# HUB_LLM_CODE_MODEL=qwen/qwen3.5-9b
